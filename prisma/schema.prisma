// Prisma 7 schema. The connection URL lives in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// No owner yet: auth (Better Auth) is a later step. When it lands, a migration
// adds `userId` + the `User` relation and the index becomes [userId, createdAt]
// (see SPEC.md §3.2).
model Todo {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(200)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("todos")
}
