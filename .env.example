# Copy to .env and fill in from the Neon dashboard (use your `dev` branch).

# Neon — pooled connection string, used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Neon — direct (unpooled) connection string, used by the Prisma CLI for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"
